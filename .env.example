# ============================================
# ENVIRONMENT VARIABLES - CNPJ FINDER PRO
# ============================================

# Environment Mode
NODE_ENV=development
REACT_APP_ENV=development

# Application
REACT_APP_NAME=CNPJ Finder Pro
REACT_APP_VERSION=1.0.0
REACT_APP_BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_API_TIMEOUT=30000
REACT_APP_MAX_RETRIES=3

# CNPJ APIs
REACT_APP_CNPJ_WS_BASE_URL=https://www.cnpj.ws/api
REACT_APP_CNPJ_WS_API_KEY=your_cnpj_ws_api_key
REACT_APP_PROCEP_BASE_URL=https://www.procep.com.br/api
REACT_APP_PROCEP_API_KEY=your_procep_api_key
REACT_APP_RECEITA_FEDERAL_BASE_URL=https://cnpja.com/api

# Elasticsearch
REACT_APP_ELASTICSEARCH_HOST=http://localhost:9200
REACT_APP_ELASTICSEARCH_USERNAME=elastic
REACT_APP_ELASTICSEARCH_PASSWORD=changeme
REACT_APP_ELASTICSEARCH_INDEX_CNPJ=cnpj_index
REACT_APP_ELASTICSEARCH_INDEX_GEOLOCATION=geolocation_index

# Redis Cache
REACT_APP_REDIS_HOST=localhost
REACT_APP_REDIS_PORT=6379
REACT_APP_REDIS_PASSWORD=
REACT_APP_REDIS_DB=0
REACT_APP_REDIS_TTL=3600

# Database
REACT_APP_DATABASE_URL=postgresql://user:password@localhost:5432/cnpj_finder_pro
REACT_APP_DATABASE_POOL_SIZE=10
REACT_APP_DATABASE_POOL_IDLE_TIMEOUT=30000

# Authentication & Security
REACT_APP_AUTH_SECRET=your_super_secret_key_min_32_chars
REACT_APP_JWT_SECRET=your_jwt_secret_key_min_32_chars
REACT_APP_JWT_EXPIRATION=7d
REACT_APP_REFRESH_TOKEN_EXPIRATION=30d

# OAuth/SSO
REACT_APP_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
REACT_APP_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
REACT_APP_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
REACT_APP_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
REACT_APP_OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
REACT_APP_OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Two-Factor Authentication (MFA)
REACT_APP_MFA_ENABLED=true
REACT_APP_MFA_WINDOW=30
REACT_APP_MFA_BACKUP_CODES_COUNT=10

# Encryption
REACT_APP_ENCRYPTION_KEY=your_encryption_key_min_32_chars
REACT_APP_ENCRYPTION_ALGORITHM=aes-256-gcm

# CORS
REACT_APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:443
REACT_APP_CORS_CREDENTIALS=true
REACT_APP_CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# AWS S3 (File Storage)
REACT_APP_AWS_REGION=us-east-1
REACT_APP_AWS_ACCESS_KEY_ID=your_aws_access_key
REACT_APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
REACT_APP_AWS_S3_BUCKET=cnpj-finder-pro-files
REACT_APP_AWS_S3_URL=https://s3.amazonaws.com
REACT_APP_FILE_MAX_SIZE=5242880
REACT_APP_FILE_ALLOWED_TYPES=pdf,xlsx,csv,json

# Email Service
REACT_APP_SMTP_HOST=smtp.gmail.com
REACT_APP_SMTP_PORT=587
REACT_APP_SMTP_USER=your_email@gmail.com
REACT_APP_SMTP_PASSWORD=your_app_password
REACT_APP_SMTP_FROM=noreply@cnpjfinderpro.com
REACT_APP_SMTP_TLS=true

# SMS Service (Twilio)
REACT_APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid
REACT_APP_TWILIO_AUTH_TOKEN=your_twilio_auth_token
REACT_APP_TWILIO_PHONE_NUMBER=+1234567890

# Error Tracking (Sentry)
REACT_APP_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
REACT_APP_SENTRY_ENVIRONMENT=development
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging
REACT_APP_LOG_LEVEL=debug
REACT_APP_LOG_FORMAT=json
REACT_APP_LOG_DIR=./logs

# Analytics
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
REACT_APP_MIXPANEL_TOKEN=your_mixpanel_token

# Feature Flags
REACT_APP_FEATURE_FLAGS_ENABLED=true
REACT_APP_FEATURE_GEOLOCATION=true
REACT_APP_FEATURE_ADVANCED_FILTERS=true
REACT_APP_FEATURE_EXPORT_PDF=true
REACT_APP_FEATURE_REAL_TIME_ALERTS=true
REACT_APP_FEATURE_WEBHOOKS=true
REACT_APP_FEATURE_API_ACCESS=true

# Geolocation
REACT_APP_GEOLOCATION_ENABLED=true
REACT_APP_GEOLOCATION_GOOGLE_MAPS_KEY=your_google_maps_api_key
REACT_APP_GEOLOCATION_RADIUS_DEFAULT=5
REACT_APP_GEOLOCATION_RADIUS_MAX=50

# Performance
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_DURATION=3600
REACT_APP_COMPRESSION_ENABLED=true
REACT_APP_COMPRESSION_LEVEL=6
REACT_APP_CDN_URL=https://cdn.cnpjfinderpro.com

# Webhooks
REACT_APP_WEBHOOKS_ENABLED=true
REACT_APP_WEBHOOKS_TIMEOUT=10000
REACT_APP_WEBHOOKS_RETRY_ATTEMPTS=3
REACT_APP_WEBHOOKS_RETRY_DELAY=5000

# Rate Limiting
REACT_APP_RATE_LIMIT_ENABLED=true
REACT_APP_RATE_LIMIT_WINDOW_MS=900000
REACT_APP_RATE_LIMIT_MAX_REQUESTS=100
REACT_APP_RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# HTTPS/SSL
REACT_APP_HTTPS_ENABLED=true
REACT_APP_SSL_CERT_PATH=./certs/server.crt
REACT_APP_SSL_KEY_PATH=./certs/server.key

# Mobile App
REACT_APP_MOBILE_API_URL=https://api.cnpjfinderpro.com
REACT_APP_MOBILE_BUNDLE_ID=com.cnpjfinderpro.mobile
REACT_APP_MOBILE_APP_ID=cnpj-finder-pro
REACT_APP_GOOGLE_PLAY_STORE_ID=com.cnpjfinderpro
REACT_APP_APPLE_BUNDLE_ID=com.cnpjfinderpro

# Server Port (Backend)
PORT=3001
HOST=0.0.0.0
