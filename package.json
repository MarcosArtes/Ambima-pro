{
  "name": "cnpj-finder-pro",
  "version": "1.0.0",
  "description": "Enterprise CNPJ Lookup System with Geolocation, Real-time Alerts, and Multi-platform Support",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm run dev:web & npm run dev:api",
    "dev:web": "vite",
    "dev:api": "node --watch src/server/index.js",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc && node scripts/build-api.js",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "sast": "sonarqube-scanner",
    "security:audit": "npm audit",
    "docker:build": "docker build -t cnpj-finder-pro:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "mobile:android": "eas build --platform android",
    "mobile:ios": "eas build --platform ios",
    "mobile:preview": "expo start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed-database.js",
    "db:reset": "prisma migrate reset",
    "ci:lint": "npm run lint && npm run type-check",
    "ci:test": "npm run test -- --run",
    "ci:build": "npm run build",
    "ci:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "zustand": "^4.4.1",
    "axios": "^1.6.0",
    "@tanstack/react-query": "^5.20.0",
    "@elastic/elasticsearch": "^8.10.0",
    "@mapbox/mapbox-gl": "^3.0.0",
    "@react-google-maps/api": "^2.19.0",
    "dotenv": "^16.3.1",
    "jose": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "crypto-js": "^4.1.1",
    "node-cache": "^5.1.2",
    "redis": "^4.6.11",
    "@prisma/client": "^5.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1547.0",
    "nodemailer": "^6.9.7",
    "twilio": "^3.95.0",
    "@sentry/react": "^7.84.0",
    "@sentry/tracing": "^7.84.0",
    "winston": "^3.11.0",
    "pino": "^8.17.0",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "qs": "^6.11.2",
    "expo": "^50.0.0",
    "expo-location": "^16.6.0",
    "react-native": "^0.72.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.5.0",
    "react-native-screens": "^3.27.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/drawer": "^6.6.9"
  },
  "devDependencies": {
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.2",
    "vite": "^5.0.7",
    "@vitejs/plugin-react": "^4.2.0",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "playwright": "^1.40.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.0",
    "prisma": "^5.5.0",
    "@prisma/internals": "^5.5.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "sonarqube-scanner": "^3.3.0"
  },
  "prisma": {
    "seed": "node scripts/seed-database.js"
  }
}
